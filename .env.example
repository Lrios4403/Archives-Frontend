# Copy to .env and adjust. Both values are URLs of the same Bun backend, seen
# from two different places — which is why there are two of them and not one.
#
# Neither is a secret. .env is ignored because the values differ per machine,
# not because anything in it is sensitive.

# The address a BROWSER dials.
#
# NEXT_PUBLIC_ is required and is not decoration: without that prefix the value
# simply does not exist on the client, and this one is read there. Next inlines
# it into the JavaScript bundle at BUILD time, so it must be correct when the
# image is built — setting it afterwards changes nothing.
#
# Exactly one thing needs it: the viewer iframe's src on /warcs/view. That
# request is made by the reader's browser, so it has to be reachable from there,
# and it is deliberately cross-origin — the origin check on the archived page's
# `warc-navigate` postMessage is only meaningful because the capture sits on a
# different origin from the app around it.
#
# Get this wrong and nothing errors: the iframe points at the visitor's own
# machine and the viewer is simply blank.
#
# Production: https://archives.m4cgyver.net
# Single machine, everything local: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# The address the NEXT SERVER dials.
#
# Used by the server components in lib/db.tsx and by the rewrite destinations in
# next.config.mjs. It never reaches a browser, so it is free to be a tunnel
# endpoint, a private address, or a docker service name.
#
# When the backend lives on another host, this is its address as the Next server
# sees it — typically a private or tunnel address that no browser could resolve,
# which is exactly why it is separate from the public one above. On one machine
# with everything local, leave it as the default.
#
# Falls back to NEXT_PUBLIC_API_URL when unset, so a single-machine setup only
# has to configure one variable.
API_INTERNAL_URL=http://localhost:3000

# Shared secret for POST /api/revalidate, which flushes the "archives" cache tag
# after a parse run finishes.
#
# UNSET BY DEFAULT, AND THAT IS SAFE: the route compares digests and answers 404
# when the variable is missing, so an unconfigured deployment refuses every
# revalidation rather than accepting any. Set it only when something is actually
# going to call the endpoint, and set the same value on the caller.
# REVALIDATE_SECRET=

# Where last-known-good readings are persisted between deploys.
#
# Optional. Unset, lib/snapshot.ts falls back to the seed files committed in
# lib/snapshots/, which means a backend outage shows stale-but-real numbers from
# whenever those were captured rather than nothing. Point this at a writable
# volume to have fresh readings survive a container rebuild.
# ARCHIVE_SNAPSHOT_DIR=/data/snapshots
